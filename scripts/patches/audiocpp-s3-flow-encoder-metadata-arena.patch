 namespace engine::models::chatterbox {
 namespace {
 
+// The flow-encoder graph contexts below are created with no_alloc = true: they only hold ggml_tensor headers and
+// one cgraph (tensor data is placed by ggml_gallocr). ggml_init() still reserves mem_size up front, and one
+// encoder runner holds ten layers x (attention + feed-forward) of them at once. Every tensor reachable from a
+// graph is a node or a leaf, and ggml_build_forward_expand() caps both at `graph_nodes`, so
+// cgraph + 4 * graph_nodes tensor headers (2x headroom over nodes + leafs) bounds the arena.
+size_t metadata_arena_bytes(size_t requested_bytes, size_t graph_nodes) {
+    const size_t bound = ggml_graph_overhead_custom(graph_nodes, false) + 4 * graph_nodes * ggml_tensor_overhead();
+    return std::min(requested_bytes, bound);
+}
