         graph_ = ggml_new_graph_custom(ctx_, 65536, false);
         ggml_build_forward_expand(graph_, post_);
         gallocr_ = ggml_gallocr_new(ggml_backend_get_default_buffer_type(weights.execution_context->backend()));
